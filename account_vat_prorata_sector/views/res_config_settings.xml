<odoo>


<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">vat.prorata.res.config.settings.form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="account.res_config_settings_view_form" />
    <field name="arch" type="xml">
        <xpath expr="//block[@id='analytic']" position="after">
            <block title="VAT Pro Rata" id="vat_pro_rata">
                <setting id="vat_pro_rata-settings" string="Company has VAT Prorata">
                    <field name="vat_prorata"/>
                    <div class="content-group" invisible="not vat_prorata">
                        <div class="row mt8">
                            <label for="vat_prorata_journal_id" class="col-lg-5 o_light_label"/>
                            <field name="vat_prorata_journal_id"/>
                        </div>
                    </div>
                </setting>
            </block>
        </xpath>
    </field>
</record>


</odoo>
